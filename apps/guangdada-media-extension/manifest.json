{
  "manifest_version": 3,
  "name": "广大大 · 页面媒体下载",
  "version": "1.9.1",
  "description": "跨页采集图片、视频与Playable原HTML，自动尝试补全视频外链，汇总为一个 ZIP 并附MD报告。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "alarms",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集并打包媒体 ZIP"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
