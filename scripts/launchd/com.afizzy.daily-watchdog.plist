<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.afizzy.daily-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/ggbond/oliver/replica-listener/scripts/afizzy_daily_watchdog.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/ggbond/oliver/replica-listener</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>Asia/Shanghai</string>
		<key>AFIZZY_WATCHDOG_ARGS</key>
		<string>--notify</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>20</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/ggbond/oliver/afizzy-state/data/logs/afizzy-daily-watchdog.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ggbond/oliver/afizzy-state/data/logs/afizzy-daily-watchdog.error.log</string>
</dict>
</plist>
